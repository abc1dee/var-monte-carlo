# =============================================================================
# VaR Monte Carlo Backend — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
#
# NEVER commit the real `.env` file — it is git-ignored.
# =============================================================================

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → Data API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Get this from: Supabase Dashboard → Project Settings → Authentication → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
